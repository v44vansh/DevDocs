DEVDOCS_AUTH_SECRET=replace-this-for-a-shared-environment
DEVDOCS_DEMO_USERNAME=demo
DEVDOCS_DEMO_PASSWORD=demo
# Leave unset for process-local memory, or point at a writable local directory.
DEVDOCS_DATA_DIR=
DEVDOCS_MAX_UPLOAD_BYTES=5242880
DEVDOCS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional local Ollama endpoint. Leave blank for the deterministic offline composer.
DEVDOCS_OLLAMA_URL=
DEVDOCS_OLLAMA_MODEL=qwen2.5:3b
